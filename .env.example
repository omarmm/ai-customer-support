APP_ENV=local
APP_NAME=AI Customer Support Backend

DATABASE_URL=
QDRANT_URL=
OLLAMA_URL=
LLM_PROVIDER=ollama

LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=8.0
LLM_RETRY_JITTER=0.0

# JSON mapping model -> {"input_per_1m": <price>, "output_per_1m": <price>}.
# Prices are per one million tokens. Empty means cost is unavailable.
# Example: LLM_PRICING={"qwen3:8b": {"input_per_1m": 0.0, "output_per_1m": 0.0}}
LLM_PRICING=
LLM_PRICING_CURRENCY=USD

# Knowledge document ingestion. Relative KNOWLEDGE_DIR paths resolve against
# the repository root, not the process working directory.
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_MAX_DOCUMENT_BYTES=1048576
KNOWLEDGE_MAX_DOCUMENTS_PER_RUN=1000

# Knowledge document chunking. Overlap must be less than the maximum.
# The 500/75 defaults are validated for the approved embedding model:
# 500 + 4 prefix + 2 special = 506 tokens, within the 2048-token input limit.
KNOWLEDGE_CHUNK_MAX_TOKENS=500
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=75

# Knowledge document embeddings. Operational only: these values are excluded
# from the embedding configuration identity. The retry maximum delay must be
# greater than or equal to the base delay. The model, dimension, and prefixes
# are pinned in code and are not environment overrides.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BASE_DELAY=0.5
EMBEDDING_RETRY_MAX_DELAY=8.0
EMBEDDING_RETRY_JITTER=0.0
